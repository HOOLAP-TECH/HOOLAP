<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>HOOLAP — Technology</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "SF Pro Text",
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

      color: #1d1d1f;
      background:
        radial-gradient(
          circle at 15% 25%,
          rgba(70, 190, 255, 0.20),
          transparent 35%
        ),
        radial-gradient(
          circle at 85% 30%,
          rgba(180, 130, 255, 0.17),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #f8fbff 0%,
          #ffffff 45%,
          #faf8ff 100%
        );

      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =========================
       상단 네비게이션
    ========================= */

    .nav-wrap {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);

      width: min(1160px, calc(100% - 32px));

      z-index: 1000;

      transition:
        width 0.45s cubic-bezier(.22,1,.36,1),
        top 0.45s cubic-bezier(.22,1,.36,1);
    }

    .nav {
      height: 64px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 28px;

      border: 1px solid rgba(255,255,255,0.75);

      border-radius: 34px;

      background: rgba(255,255,255,0.68);

      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);

      box-shadow:
        0 10px 35px rgba(0,0,0,0.07),
        inset 0 1px 0 rgba(255,255,255,0.8);

      transition:
        height 0.45s cubic-bezier(.22,1,.36,1),
        padding 0.45s cubic-bezier(.22,1,.36,1),
        border-radius 0.45s cubic-bezier(.22,1,.36,1);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 7px;

      font-size: 20px;
      font-weight: 700;

      letter-spacing: -0.6px;

      color: #111;
    }

    .apple {
      font-size: 21px;
      line-height: 1;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav-links a {
      font-size: 16px;
      font-weight: 600;

      color: #1d1d1f;

      transition:
        color 0.25s ease,
        transform 0.25s ease;
    }

    .nav-links a:hover {
      color: #007aff;
      transform: translateY(-1px);
    }

    .nav-links a.active {
      color: #007aff;
    }

    /* 스크롤 시 네비게이션 축소 */

    .nav-wrap.compact {
      top: 10px;
      width: min(1000px, calc(100% - 48px));
    }

    .nav-wrap.compact .nav {
      height: 50px;
      padding: 0 23px;
      border-radius: 27px;
    }

    .nav-wrap.compact .nav-logo {
      font-size: 17px;
    }

    .nav-wrap.compact .apple {
      font-size: 18px;
    }

    .nav-wrap.compact .nav-links {
      gap: 23px;
    }

    .nav-wrap.compact .nav-links a {
      font-size: 14px;
    }


    /* =========================
       공통 섹션
    ========================= */

    section {
      position: relative;
      width: 100%;
    }

    .section-inner {
      width: min(1100px, calc(100% - 40px));
      margin: 0 auto;
    }


    /* =========================
       HOME
    ========================= */

    .hero {
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      text-align: center;

      padding:
        150px 25px
        100px;

      overflow: hidden;
    }

    .hero-content {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;

      padding: 11px 17px;

      border-radius: 999px;

      background: rgba(255,255,255,0.70);

      border: 1px solid rgba(255,255,255,0.85);

      box-shadow:
        0 8px 30px rgba(0,0,0,0.05),
        inset 0 1px 0 rgba(255,255,255,0.8);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      color: #555;

      font-size: 15px;
      font-weight: 500;
    }

    .badge-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: #34c759;

      box-shadow:
        0 0 10px rgba(52,199,89,0.45);
    }

    .hero h1 {
      margin-top: 40px;

      font-size: clamp(64px, 14vw, 165px);

      line-height: 0.92;

      letter-spacing: -0.075em;

      font-weight: 800;

      white-space: normal;

      background:
        linear-gradient(
          110deg,
          #0b4f91,
          #087fff 50%,
          #6957e8
        );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }

    .hero .lead {
      max-width: 800px;

      margin: 38px auto 0;

      font-size: clamp(16px, 2vw, 21px);

      line-height: 1.75;

      letter-spacing: -0.035em;

      color: #6e6e73;
    }

    .buttons {
      display: flex;
      justify-content: center;
      align-items: center;

      gap: 16px;

      margin-top: 40px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-width: 170px;

      padding: 16px 25px;

      border-radius: 999px;

      font-size: 16px;
      font-weight: 700;

      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        background 0.3s ease;
    }

    .button:hover {
      transform: translateY(-3px);
    }

    .button-primary {
      color: white;

      background:
        linear-gradient(
          135deg,
          #007aff,
          #287cff
        );

      box-shadow:
        0 12px 30px rgba(0,122,255,0.28);
    }

    .button-primary:hover {
      box-shadow:
        0 18px 40px rgba(0,122,255,0.35);
    }

    .button-secondary {
      color: #1d1d1f;

      background: rgba(255,255,255,0.75);

      border: 1px solid rgba(255,255,255,0.9);

      box-shadow:
        0 10px 30px rgba(0,0,0,0.06);
    }


    /* =========================
       HOME 처음 진입 애니메이션
    ========================= */

    .hero .badge,
    .hero h1,
    .hero .lead,
    .hero .buttons {
      opacity: 0;

      transform:
        translate3d(0, 45px, 0)
        scale(0.96);

      filter: blur(8px);
    }

    .hero.home-start .badge {
      animation:
        homeIn
        0.85s
        cubic-bezier(.22,1,.36,1)
        0.10s
        forwards;
    }

    .hero.home-start h1 {
      animation:
        homeIn
        1s
        cubic-bezier(.22,1,.36,1)
        0.18s
        forwards;
    }

    .hero.home-start .lead {
      animation:
        homeIn
        0.9s
        cubic-bezier(.22,1,.36,1)
        0.32s
        forwards;
    }

    .hero.home-start .buttons {
      animation:
        homeIn
        0.9s
        cubic-bezier(.22,1,.36,1)
        0.44s
        forwards;
    }

    @keyframes homeIn {
      from {
        opacity: 0;

        transform:
          translate3d(0, 45px, 0)
          scale(0.96);

        filter: blur(8px);
      }

      to {
        opacity: 1;

        transform:
          translate3d(0, 0, 0)
          scale(1);

        filter: blur(0);
      }
    }


    /* =========================
       카드 섹션
    ========================= */

    .content-section {
      padding: 150px 0;
    }

    .section-title {
      text-align: center;

      font-size: clamp(38px, 6vw, 70px);

      line-height: 1.05;

      letter-spacing: -0.065em;

      font-weight: 800;

      margin-bottom: 22px;
    }

    .section-description {
      max-width: 650px;

      margin: 0 auto 60px;

      text-align: center;

      color: #777;

      font-size: 18px;

      line-height: 1.7;

      letter-spacing: -0.03em;
    }

    .cards {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 22px;
    }

    .card {
      min-height: 270px;

      padding: 35px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      border-radius: 30px;

      background:
        rgba(255,255,255,0.70);

      border:
        1px solid rgba(255,255,255,0.85);

      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);

      box-shadow:
        0 15px 45px rgba(0,0,0,0.06),
        inset 0 1px 0 rgba(255,255,255,0.85);

      transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
    }

    .card:hover {
      transform: translateY(-8px);

      box-shadow:
        0 25px 60px rgba(0,0,0,0.10);
    }

    .card-icon {
      width: 54px;
      height: 54px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 17px;

      background: #f2f2f7;

      font-size: 25px;
    }

    .card h3 {
      margin-top: 25px;

      font-size: 26px;

      letter-spacing: -0.045em;
    }

    .card p {
      margin-top: 12px;

      color: #777;

      line-height: 1.65;

      font-size: 15px;
    }


    /* =========================
       INTRO
    ========================= */

    .intro {
      padding: 160px 0;

      background:
        linear-gradient(
          180deg,
          transparent,
          rgba(240,247,255,0.55),
          transparent
        );
    }

    .intro-box {
      padding: 90px 50px;

      text-align: center;

      border-radius: 40px;

      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,0.75),
          rgba(246,248,255,0.72)
        );

      border:
        1px solid rgba(255,255,255,0.9);

      box-shadow:
        0 20px 70px rgba(0,0,0,0.06);

      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
    }

    .intro-box h2 {
      font-size: clamp(40px, 6vw, 72px);

      line-height: 1.05;

      letter-spacing: -0.07em;
    }

    .intro-box p {
      max-width: 700px;

      margin: 30px auto 0;

      color: #707070;

      font-size: 18px;

      line-height: 1.8;
    }


    /* =========================
       ABOUT
    ========================= */

    .about {
      padding: 150px 0;
    }

    .about-grid {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 70px;

      align-items: center;
    }

    .about h2 {
      font-size: clamp(40px, 6vw, 70px);

      line-height: 1.05;

      letter-spacing: -0.065em;
    }

    .about-text {
      color: #6e6e73;

      font-size: 18px;

      line-height: 1.8;

      margin-top: 28px;
    }

    .about-card {
      padding: 45px;

      border-radius: 32px;

      background:
        rgba(255,255,255,0.72);

      border:
        1px solid rgba(255,255,255,0.9);

      box-shadow:
        0 20px 60px rgba(0,0,0,0.07);

      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .about-card h3 {
      font-size: 25px;

      margin-bottom: 20px;

      letter-spacing: -0.04em;
    }

    .about-card p {
      color: #737373;

      line-height: 1.75;
    }


    /* =========================
       FOLLOW
    ========================= */

    .follow {
      padding: 150px 0 180px;

      text-align: center;
    }

    .follow h2 {
      font-size: clamp(42px, 7vw, 80px);

      letter-spacing: -0.07em;
    }

    .follow p {
      margin-top: 22px;

      color: #777;

      font-size: 18px;
    }

    .follow-buttons {
      display: flex;

      justify-content: center;

      gap: 15px;

      margin-top: 35px;
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 35px 20px 45px;

      text-align: center;

      color: #999;

      font-size: 14px;

      border-top:
        1px solid rgba(0,0,0,0.05);
    }


    /* =========================
       스크롤 등장 애니메이션
    ========================= */

    .reveal {
      opacity: 0;

      filter: blur(5px);

      transition:
        opacity 0.8s cubic-bezier(.22,1,.36,1),
        transform 0.85s cubic-bezier(.22,1,.36,1),
        filter 0.8s cubic-bezier(.22,1,.36,1);
    }

    /* 아래에서 올라오는 방향 */

    .reveal.from-bottom {
      transform:
        translate3d(0, 65px, 0)
        scale(0.97);
    }

    /* 위에서 내려오는 방향 */

    .reveal.from-top {
      transform:
        translate3d(0, -65px, 0)
        scale(0.97);
    }

    /* 정상 상태 */

    .reveal.is-visible {
      opacity: 1;

      transform:
        translate3d(0, 0, 0)
        scale(1);

      filter: blur(0);
    }


    /* =========================
       반응형
    ========================= */

    @media (max-width: 800px) {

      .nav-wrap {
        width: calc(100% - 24px);
        top: 12px;
      }

      .nav {
        height: 58px;

        padding: 0 20px;
      }

      .nav-links {
        gap: 15px;
      }

      .nav-links a {
        font-size: 14px;
      }

      .hero {
        padding:
          130px 20px
          80px;
      }

      .hero h1 {
        font-size:
          clamp(55px, 17vw, 110px);

        line-height: 0.95;
      }

      .hero .lead {
        font-size: 16px;
      }

      .buttons {
        flex-direction: column;

        width: 100%;

        gap: 12px;
      }

      .button {
        width: min(280px, 100%);
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .about-grid {
        grid-template-columns: 1fr;

        gap: 40px;
      }

      .intro-box {
        padding: 65px 25px;
      }

      .content-section,
      .intro,
      .about,
      .follow {
        padding-top: 110px;
        padding-bottom: 110px;
      }

      .nav-wrap.compact {
        width: calc(100% - 32px);
      }

      .nav-wrap.compact .nav {
        height: 48px;

        padding: 0 18px;
      }

      .nav-wrap.compact .nav-links {
        gap: 14px;
      }

      .nav-wrap.compact .nav-links a {
        font-size: 13px;
      }
    }


    @media (max-width: 480px) {

      .nav-logo {
        font-size: 17px;
      }

      .apple {
        font-size: 18px;
      }

      .nav-links {
        gap: 11px;
      }

      .nav-links a {
        font-size: 13px;
      }

      .hero h1 {
        font-size: 19vw;
      }

      .badge {
        font-size: 13px;

        padding: 9px 13px;
      }

      .card {
        padding: 28px;

        min-height: 240px;
      }

      .about-card {
        padding: 30px;
      }
    }

  </style>
</head>


