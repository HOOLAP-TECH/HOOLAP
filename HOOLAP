/* ==================================================
   BUTTON
================================================== */

.btn{
  display:inline-flex;

  align-items:center;
  justify-content:center;

  min-width:145px;

  padding:14px 21px;

  border-radius:999px;

  font-size:15px;
  font-weight:600;

  transition:
    transform .3s cubic-bezier(.22,1,.36,1),
    box-shadow .3s ease,
    background .3s ease;
}

.btn:hover{
  transform:translateY(-3px);
}

.btn:active{
  transform:scale(.95);
}

.btn-primary{
  color:#fff;

  background:#007aff;

  box-shadow:
    0 10px 25px rgba(0,122,255,.25);
}

.btn-primary:hover{
  box-shadow:
    0 15px 35px rgba(0,122,255,.32);
}

.btn-secondary{
  color:#111;

  background:
    rgba(255,255,255,.8);

  border:
    1px solid rgba(0,0,0,.08);
