/* ==================================================
   SCROLL REVEAL
================================================== */

.reveal{
  opacity:0;

  transform:
    translate3d(0,70px,0)
    scale(.97);

  filter:blur(6px);

  will-change:
    transform,
    opacity,
    filter;

  transition:
    opacity .75s cubic-bezier(.22,1,.36,1),
    transform .85s cubic-bezier(.22,1,.36,1),
    filter .75s cubic-bezier(.22,1,.36,1);
}


/* 아래로 스크롤 → 아래에서 위 */

.reveal.from-bottom{
  opacity:1;

  transform:
    translate3d(0,0,0)
    scale(1);

  filter:blur(0);
}


/* 위로 스크롤 → 위에서 아래 */

.reveal.from-top{
  opacity:1;

  transform:
    translate3d(0,0,0)
    scale(1);

  filter:blur(0);
}


/* 아래로 스크롤 → 위로 사라짐 */

.reveal.exit-top{
  opacity:0;

  transform:
    translate3d(0,-65px,0)
    scale(.97);

  filter:blur(6px);
}


/* 위로 스크롤 → 아래로 사라짐 */

.reveal.exit-bottom{
  opacity:0;

  transform:
    translate3d(0,65px,0)
    scale(.97);

  filter:blur(6px);
}


