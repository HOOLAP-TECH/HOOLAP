<script>

/* ==================================================
   HOME — 사이트 진입 애니메이션
================================================== */

const home =
  document.querySelector(".hero");


/*
   페이지가 처음 열렸을 때
   무조건 Home 애니메이션 시작

   DOMContentLoaded를 사용해서
   사이트 진입 직후 바로 실행한다.
*/

document.addEventListener(
  "DOMContentLoaded",
  () => {

    requestAnimationFrame(
      () => {

        requestAnimationFrame(
          () => {

            home.classList.add(
              "home-start"
            );

          }
        );

      }
    );

  }
);


/* ==================================================
   스크롤 방향
================================================== */

let lastScrollY =
  window.scrollY;

let scrollDirection =
  "down";


window.addEventListener(
  "scroll",
  () => {

    const currentY =
      window.scrollY;


    if(
      currentY > lastScrollY
    ){

      scrollDirection =
        "down";

    }
    else if(
      currentY < lastScrollY
    ){

      scrollDirection =
        "up";

    }


    lastScrollY =
      currentY;

  },
  {
    passive:true
  }
);


/* ==================================================
   NAV 크기
================================================== */

const nav =
  document.querySelector(".nav");


window.addEventListener(
  "scroll",
  () => {

    const currentY =
      window.scrollY;


    if(
      scrollDirection === "down" &&
      currentY > 80
    ){

      nav.classList.add(
        "compact"
      );

    }


    if(
      scrollDirection === "up"
    ){

      nav.classList.remove(
        "compact"
      );

    }

  },
  {
    passive:true
  }
);


/* ==================================================
   CONTENT REVEAL
================================================== */

const revealElements =
  document.querySelectorAll(
    ".reveal"
  );


const revealObserver =
  new IntersectionObserver(

    (entries) => {

      entries.forEach(
        (entry) => {

          const element =
            entry.target;


          if(
            entry.isIntersecting
          ){

            /*
              아래로 스크롤:
              아래 → 위
            */

            if(
              scrollDirection === "down"
            ){

              element.classList.remove(
                "exit-top",
                "exit-bottom",
                "from-top"
              );

              element.classList.add(
                "from-bottom"
              );

            }


            /*
              위로 스크롤:
              위 → 아래
            */

            else{

              element.classList.remove(
                "exit-top",
                "exit-bottom",
                "from-bottom"
              );

              element.classList.add(
                "from-top"
              );

            }

          }


          else{

            const rect =
              element.getBoundingClientRect();


            /*
              아래로 내려갈 때
              화면 위쪽으로 사라짐
            */

            if(
              scrollDirection === "down" &&
              rect.bottom < 0
            ){

              element.classList.remove(
                "from-bottom",
                "from-top"
              );

              element.classList.add(
                "exit-top"
              );

            }


            /*
              위로 올라갈 때
              화면 아래쪽으로 사라짐
            */

            else if(
              scrollDirection === "up" &&
              rect.top > window.innerHeight
            ){

              element.classList.remove(
                "from-bottom",
                "from-top"
              );

              element.classList.add(
                "exit-bottom"
              );

            }

          }

        }
      );

    },

    {
      threshold:.12,

      rootMargin:
        "-50px 0px -80px 0px"
    }

  );


revealElements.forEach(
  (element) => {

    revealObserver.observe(
      element
    );

  }
);


/* ==================================================
   HOME 재진입 애니메이션
================================================== */

let homeWasVisible =
  true;


const homeObserver =
  new IntersectionObserver(

    (entries) => {

      entries.forEach(
        (entry) => {

          /*
             Home에서 멀어짐
          */

          if(
            !entry.isIntersecting
          ){

            homeWasVisible =
              false;

          }


          /*
             아래에서 위로 Home에 다시 들어옴
          */

          else if(
            !homeWasVisible &&
            scrollDirection === "up"
          ){

            homeWasVisible =
              true;


            home.classList.remove(
              "home-start",
              "home-replay"
            );


            /*
               브라우저가 기존 애니메이션을
               확실히 초기화하도록 강제
            */

            void home.offsetWidth;


            home.classList.add(
              "home-replay"
            );

          }

        }
      );

    },

    {
      threshold:.35
    }

  );


homeObserver.observe(home);


/* ==================================================
   NAV ACTIVE
================================================== */

const sections =
  document.querySelectorAll(
    "section[id]"
  );

const navLinks =
  document.querySelectorAll(
    ".nav-links a"
  );


const sectionObserver =
  new IntersectionObserver(

    (entries) => {

      entries.forEach(
        (entry) => {

          if(
            entry.isIntersecting
          ){

            const id =
              entry.target.id;


            navLinks.forEach(
              (link) => {

                link.classList.remove(
                  "active"
                );


                if(
                  link.getAttribute("href")
                  === "#" + id
                ){

                  link.classList.add(
                    "active"
                  );

                }

              }
            );

          }

        }
      );

    },

    {
      threshold:.35
    }

  );


sections.forEach(
  (section) => {

    sectionObserver.observe(
      section
    );

  }
);


/* ==================================================
   NAV 클릭
================================================== */

navLinks.forEach(
  (link) => {

    link.addEventListener(
      "click",
      () => {

        navLinks.forEach(
          (item) => {

            item.classList.remove(
              "active"
            );

          }
        );


        link.classList.add(
          "active"
        );

      }
    );

  }
);

</script>

</body>
</html>
